# Copy to `.env` and fill in values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Database (MariaDB on NAS or local)
# Prisma / Next.js use this connection string.
# Example (Workbench / NAS): create DB `vierdevrijdag` utf8mb4, then:
#   mysql://USER:PASSWORD@HOST:3306/vierdevrijdag
# For Synology MariaDB on same host as Docker with bridge network, use the NAS
# LAN IP instead of localhost. For `network_mode: host`, localhost is fine.
#
# The app appends connect_timeout=10 if your URL does not already set connect_timeout
# (avoids hanging forever on a dead host). Override in the URL if you want a different value.
#
# From another machine, use the NAS LAN IP (not localhost). Match the MySQL user host:
# e.g. user@192.168.178.% in phpMyAdmin → host in URL must be that NAS IP.
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://vierdevrijdag:CHANGE_ME@127.0.0.1:3306/vierdevrijdag"

# -----------------------------------------------------------------------------
# NextAuth (required in production)
# NEXTAUTH_URL must match the public URL users open (no trailing slash).
# Ook gebruikt voor deel-links (WhatsApp, LinkedIn, …) op de publieke site.
# Behind Synology reverse proxy + HTTPS, use https://your-domain.example
#
# Generate NEXTAUTH_SECRET on the CLI (pick one):
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Paste the output as the value below (no quotes needed unless it contains spaces).
# -----------------------------------------------------------------------------
# Must match the URL you type in the browser (scheme + host + port). If you use http:// on LAN,
# keep http:// here — production NODE_ENV alone does not force HTTPS cookies anymore.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="paste-output-from-openssl-or-node-command-above"

# Optional: force auth cookie Secure flag + __Secure-/__Host- names (default: derived from NEXTAUTH_URL https://).
# AUTH_COOKIE_SECURE="true"

# If the app is served on a different internal URL than the public one, you can
# set this (rare). See NextAuth docs.
# NEXTAUTH_URL_INTERNAL="http://127.0.0.1:3000"

# Trust the Host header when behind a reverse proxy (often needed on NAS).
# Set to true only if you understand the security implications.
# AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Optional: poster template path (defaults to public/template.png)
# -----------------------------------------------------------------------------
# POSTER_TEMPLATE_PATH="/absolute/path/to/template.png"

# Generated meetup/preview JPEGs on disk (defaults to ./data/posters, same as compose bind-mount).
# Docker sets POSTER_STORAGE_DIR=/data/posters inside the container (host: ./data/posters).
# Do not store JPEGs under public/generated — the app serves /generated/posters/*.jpg from this dir via a route.
# POSTER_STORAGE_DIR="/absolute/path/to/posters"

# -----------------------------------------------------------------------------
# Nostr (NIP-05 + NIP-52 calendar publishing)
#
# 1) Generate a key pair once:
#      npm run nostr:keygen
#    Paste NOSTR_NPUB and NOSTR_NSEC below. Never commit the nsec.
#    If both npub and nsec are set, they must belong to the same key pair.
#
# 2) NIP-05 identity: meetup@<domain> is served from /.well-known/nostr.json
#    NOSTR_NPUB is used for that endpoint (and display). Signing uses NOSTR_NSEC.
#
# 3) Cron / backfill API auth — generate a random bearer token (pick one):
#      openssl rand -hex 32
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Used by POST /api/nostr/cron/publish-due and POST /api/nostr/cron/backfill
#    (and npm run nostr:backfill). Required for automated publishing.
#
# 4) All values below are required for Nostr publishing (no code defaults).
#    NOSTR_NIP05_DOMAIN: public hostname for meetup@domain NIP-05 identity.
# -----------------------------------------------------------------------------
NOSTR_NPUB="npub1..."
NOSTR_NSEC="nsec1..."
NOSTR_RELAYS="wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.snort.social"
NOSTR_CRON_TOKEN="paste-output-from-openssl-or-node-command-above"
NOSTR_NIP05_DOMAIN="vierdevrijdag.org"
NOSTR_PROFILE_NAME="meetup"
NOSTR_PROFILE_DISPLAY_NAME="VierDeVrijdag"
# NOSTR_PROFILE_PICTURE_URL="https://vierdevrijdag.org/..."
NOSTR_PROFILE_ABOUT="Maandelijkse VierDeVrijdag meetup, vierde vrijdag van de maand in Utrecht."
NOSTR_EVENT_HASHTAGS="vierdevrijdag,meetup,utrecht"
NOSTR_EVENT_D_TAG_PREFIX="vierdevrijdag"
NOSTR_CALENDAR_COLLECTION_D_TAG="vierdevrijdag-meetups"
NOSTR_CALENDAR_COLLECTION_TITLE="VierDeVrijdag Meetups"
NOSTR_CALENDAR_COLLECTION_DESCRIPTION="Maandelijkse VierDeVrijdag meetups."
NOSTR_TIMEZONE="Europe/Amsterdam"
NOSTR_MEETUP_DEFAULT_START="19:30"
NOSTR_MEETUP_DEFAULT_END="22:00"
NOSTR_DELETION_REASON="Meetup verwijderd op vierdevrijdag.org"

# -----------------------------------------------------------------------------
# Runtime (usually set by Docker / process manager, not in .env)
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
