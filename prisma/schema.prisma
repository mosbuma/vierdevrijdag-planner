generator client {
  provider      = "prisma-client-js"
  /** Explicit musl targets: Synology / Docker Alpine often mis-detects or lacks OpenSSL libs at install time. */
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(255)
  password_hash String   @map("password_hash") @db.VarChar(255)
  role          Role     @default(USER)
  created_at    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("users")
}

/** Poster template: layout regions on a shared image; meetups reference a template and keep their own export path. */
model Poster {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(128)
  slug               String   @unique @db.VarChar(64)
  template_rel_path  String   @default("template.png") @map("template_rel_path") @db.VarChar(512)
  title_region       Json?    @map("title_region")
  program_region     Json?    @map("program_region")
  sort_order         Int      @default(0) @map("sort_order")
  created_at         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at         DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  meetings Meeting[]

  @@index([sort_order])
  @@map("posters")
}

model Meeting {
  id              Int      @id @default(autoincrement())
  meetup_date     DateTime @map("meetup_date") @db.Date
  visible_from    DateTime @map("visible_from") @db.Date
  venue_line      String   @map("venue_line") @db.VarChar(512)
  event_title     String   @default("VierDeVrijdag") @map("event_title") @db.VarChar(255)
  poster_id       Int      @default(1) @map("poster_id")
  poster_rel_path String?  @map("poster_rel_path") @db.VarChar(512)
  /** Sanitized HTML for public event page (bold, italic, links, lists). */
  program_description_html String? @map("program_description_html") @db.LongText
  is_template     Boolean  @default(false) @map("is_template")
  nostr_event_id     String?   @map("nostr_event_id") @db.Char(64)
  nostr_d_tag        String?   @map("nostr_d_tag") @db.VarChar(128)
  nostr_published_at DateTime? @map("nostr_published_at") @db.DateTime(0)
  nostr_last_error   String?   @map("nostr_last_error") @db.VarChar(1024)
  created_at      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at      DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  poster Poster       @relation(fields: [poster_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tracks MeetingTrack[]
  items  ProgramItem[]

  @@unique([meetup_date])
  @@index([meetup_date])
  @@index([visible_from])
  @@index([poster_id])
  @@map("meetings")
}

model MeetingTrack {
  id         Int      @id @default(autoincrement())
  meeting_id Int      @map("meeting_id")
  name       String   @db.VarChar(100)
  sort_order Int      @default(0) @map("sort_order")
  created_at DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  meeting Meeting       @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  items   ProgramItem[]

  @@index([meeting_id])
  @@map("meeting_tracks")
}

model ProgramItem {
  id          Int      @id @default(autoincrement())
  meeting_id  Int      @map("meeting_id")
  track_id    Int      @map("track_id")
  slot_start  DateTime @map("slot_start") @db.Time(0)
  slot_end    DateTime @map("slot_end") @db.Time(0)
  description String   @db.Text
  /** Rich text for public /event block via {{program}} metatag; poster uses `description`. */
  row_description_html String? @map("row_description_html") @db.LongText
  speakers    String?  @db.VarChar(1024)
  sort_order  Int      @default(0) @map("sort_order")
  created_at  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at  DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  meeting Meeting      @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  track   MeetingTrack @relation(fields: [track_id], references: [id], onDelete: Cascade)

  @@index([meeting_id])
  @@index([track_id])
  @@map("program_items")
}

/** Append-only audit trail for authenticated mutations (API routes). */
model AuditLog {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @map("created_at") @db.DateTime(0)
  username   String   @db.VarChar(255)
  action     String   @db.VarChar(128)
  subject    String?  @db.VarChar(255)
  changes    Json?    @map("changes")

  @@index([created_at])
  @@index([username])
  @@map("audit_logs")
}

/** Singleton (id=1): Nostr profile, relays, calendar and event defaults (editable via Instellingen). */
model NostrSettings {
  id                            Int      @id @default(1)
  relays                        String   @db.Text
  nip05_domain                  String   @map("nip05_domain") @db.VarChar(255)
  content_site_origin           String   @default("https://vierdevrijdag.org") @map("content_site_origin") @db.VarChar(512)
  profile_name                  String   @map("profile_name") @db.VarChar(64)
  profile_display_name          String   @map("profile_display_name") @db.VarChar(128)
  profile_picture_url           String?  @map("profile_picture_url") @db.VarChar(512)
  profile_about                 String   @map("profile_about") @db.Text
  event_hashtags                String   @default("") @map("event_hashtags") @db.VarChar(512)
  event_d_tag_prefix            String   @map("event_d_tag_prefix") @db.VarChar(64)
  calendar_collection_d_tag     String   @map("calendar_collection_d_tag") @db.VarChar(128)
  calendar_collection_title     String   @map("calendar_collection_title") @db.VarChar(255)
  calendar_collection_description String @map("calendar_collection_description") @db.Text
  timezone                      String   @db.VarChar(64)
  meetup_default_start          String   @map("meetup_default_start") @db.VarChar(5)
  meetup_default_end            String   @map("meetup_default_end") @db.VarChar(5)
  deletion_reason               String   @map("deletion_reason") @db.VarChar(512)
  created_at                    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updated_at                    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("nostr_settings")
}
